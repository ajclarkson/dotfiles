# Font
font-family = Hack Nerd Font
font-size = 13
adjust-cell-height = 10

# Window
window-padding-x = 5
window-padding-y = 5
window-padding-balance = true

# Shell integration
shell-integration = fish
shell-integration-features = cursor,sudo,title

# Kitty keyboard protocol — enables modifier keys in Neovim without tmux conflicts
term = ghostty

# Theme — Rosé Pine
theme = Rose Pine

# macOS app icon — flat Rosé Pine ghost (~/.config/ghostty/Ghostty.icns),
# based on github.com/lukejanicke/ghostty-app-icons, recolored to Iris (#c4a7e7)
macos-icon = custom

# Hide the titlebar proxy icon — it always shows the CWD's folder icon (macOS-drawn, not themeable)
macos-titlebar-proxy-icon = hidden

# Keybindings
# Shift+Return → ESC+Enter (tmux compatibility, mirrors Alacritty binding)
keybind = shift+enter=text:\x1b\r
# Cmd+V explicitly routed to paste_from_clipboard — works around Ghostty's OSC 52
# not supporting image MIME types, which breaks image paste in Claude Code.
# Requires Ghostty to have Accessibility permissions (System Settings > Privacy & Security).
keybind = performable:super+v=paste_from_clipboard
